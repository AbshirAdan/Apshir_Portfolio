PORT=5000
NODE_ENV=development

# PostgreSQL (Neon or local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_POOL_MAX=20

# Optional consolidated URL (overrides individual DB_* if set)
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/portfolio_db

# Frontend (CORS) — Set to your Vercel URL in production
FRONTEND_URL=http://localhost:5173

# Backend URL — Set to your Render backend URL in production
API_URL=http://localhost:5000/api

# JWT — use a long random string in production (min 32 chars)
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRATION=7d

# Admin seed (development first-run only)
ADMIN_FULL_NAME=Portfolio Admin
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=change-this-strong-password

# Email Service (Nodemailer SMTP - e.g. Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Uploads (local path relative to backend/server/)
UPLOAD_MAX_SIZE=5242880

# Rate limiting — global API (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000

# Auth endpoints (login) — anti-brute-force limits
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
