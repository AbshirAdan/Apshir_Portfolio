{
  "name": "portfolio-backend",
  "version": "2.0.0",
  "description": "Portfolio Management System — Backend Foundation (Phase 2)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "predev": "node scripts/free-port.js",
    "dev": "nodemon server/server.js",
    "migrate": "node -e \"require('./server/database/migrate'); require('./server/config/db').pool; new (require('./server/database/migrate'))(require('./server/config/db').pool).run().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smoke": "node scripts/api-smoke-test.js"
  },
  "keywords": [
    "portfolio",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9"
  }
}
